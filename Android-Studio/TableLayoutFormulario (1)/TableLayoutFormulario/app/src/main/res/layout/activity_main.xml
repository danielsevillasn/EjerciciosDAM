<?xml version="1.0" encoding="utf-8"?>
<TableLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <!--  FILA 1: TÍTULO ENCABEZADO  -->
    <TableRow android:layout_marginBottom="24dp">
        <TextView android:id="@+id/tvTitulo"
            android:text="REGISTRO DE PRODUCTO"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_span="2"/>
        <!--  layout_span="2" hace que ocupe las 2 columnas disponibles  -->
    </TableRow>
    <!--  FILA 2: CÓDIGO  -->
    <TableRow android:layout_marginBottom="12dp">
        <TextView
            android:text="Código: "
            android:textSize="16sp"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etCodigo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. 1024"
            android:inputType="number"/>
    </TableRow>
    <!--  FILA 3: NOMBRE  -->
    <TableRow android:layout_marginBottom="12dp">
        <TextView
            android:text="Nombre: "
            android:textSize="16sp"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etNombre"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. Teclado Mecánico"
            android:inputType="textPersonName"/>
    </TableRow>
    <!--  FILA 4: PRECIO  -->
    <TableRow android:layout_marginBottom="24dp">
        <TextView
            android:text="Precio (€): "
            android:textSize="16sp"
            android:textStyle="bold"/>
        <EditText
            android:id="@+id/etPrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ej. 45.99"
            android:inputType="numberDecimal"/>
    </TableRow>
    <!--  FILA 5: BOTONES DE ACCIÓN  -->
    <TableRow>
        <Button
            android:id="@+id/btnLimpiar"
            android:text="Limpiar"/>
        <Button
            android:id="@+id/btnGuardar"
            android:text="Guardar"/>
    </TableRow>

</TableLayout>