CREATE TABLE EMPLEADOS(
    DNI VARCHAR2 (9),
    NOMBRE VARCHAR2 (10) NOT NULL,
    APELLIDO1 VARCHAR2 (15) NOT NULL,
    APELLIDO2 VARCHAR2 (15),
    DIRECC1 VARCHAR2 (25),
    DIRECC2 VARCHAR2 (20),
    CIUDAD VARCHAR2 (20),
    PROVINCIA VARCHAR2 (20),
    COD_POSTAL VARCHAR2 (5),
    FECHA_NAC DATE,
    SEXO VARCHAR2 (1),
    CONSTRAINT DNI_PK PRIMARY KEY (DNI),
    CONSTRAINT SEXO CHEK(SEXO IN ('H','M')),
    CONSTRAINT DNI_UK UNIQUE (DNI)
);

CREATE TABLE DEPARTAMENTOS(
    DPTO_COD NUMBER(5),
    NOMBRE_DPTO VARCHAR2 (30) NOT NULL,
    DPTO_PADRE NUMBER(5),
    PRESUPUESTO NUMBER (7,2) NOT NULL,
    PRES_ACTUAL NUMBER(7,2),
    CONSTRAINT COD_DPTO_PK PRIMARY KEY (DPTO_COD)
    CONSTRAINT DPTO_NOMBRE_UK UNIQUE (NOMBRE_DPTO)
);

CREATE TABLE ESTUDIOS(
    EMPLEADO_DNI VARCHAR2 (9),
    ESPECIALIDAD VARCHAR2 (20),
    UNIVERSIDAD NUMBER (5),
    AÑO NUMBER (4),
    GRADO VARCHAR2 (3),
    CONSTRAINT PUEMP_COD_PK PRIMARY KEY (EMPLEADO_DNI, ESPECIALIDAD)
);

CREATE TABLE HISTORIAL_LABORAL(
    EMPLEADO_DNI VARCHAR2 (9),
    TRABAJO_COD NUMBER (5),
    FECHA_INICIO DATE,
    FECHA_FIN DATE,
    DPTO_COD NUMBER (5),
    SUPERVISOR_DNI NUMBER (8),
    CONSTRAINT PUEMP_HISTORIAL_PK PRIMARY KEY (EMPLEADO_DNI, TRABAJO_COD, FECHA_INICIO) 
);

CREATE TABLE UNIVERSIDADES(
    UNIV_COD NUMBER (5),
    NOMBRE_UNIV VARCHAR2 (25) NOT NULL,
    CIUDAD VARCHAR2 (20),
    MUNICIPIO VARCHAR2 (2),
    COD_POSTAL VARCHAR2 (5),
    CONSTRAINT COD_UNIV_PK PRIMARY KEY (UNIV_COD)
);

CREATE TABLE HISTORIAL_SALARIAL(
    EMPLEADO_DNI VARCHAR2 (9),
    SALARIO NUMBER(7,2) NOT NULL,
    FECHA_COMIENZO DATE,
    FECHA_FIN DATE,
    CONSTRAINT PUEMP_HISTSAL_PK PRIMARY KEY (EMPLEADO_DNI, SALARIO, FECHA_COMIENZO)
);

CREATE TABLE TRABAJOS(
    TRABAJO_COD NUMBER (5),
    NOMBRE_TRAB VARCHAR2 (20) NOT NULL,
    SALARIO_MIN NUMBER(2) NOT NULL,
    SALARIO_MAX NUMBER(2) NOT NULL,
    CONSTRAINT COD_TRABAJO_PK PRIMARY KEY (TRABAJO_COD),
    CONSTRAINT TRAB_NOMBRE_UK UNIQUE (NOMBRE_TRAB)
);

ALTER TABLE EMPLEADOS
    ADD(
        CONSTRAINT TRABAJO_ID FOREIGN KEY (ID_TRABAJO) REFERENCES TRABAJOS(ID_TRABAJO),
    );
