<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE empleados [

    <!-- Elemento raíz -->
    <!ELEMENT empleados (empleado+)>

    <!-- Cada empleado tiene estos elementos -->
    <!ELEMENT empleado (nombre, apellido, edad, departamento, cargo)>
    
    <!-- Atributo id obligatorio -->
    <!ATTLIST empleado id CDATA #REQUIRED>

    <!-- Elementos de texto -->
    <!ELEMENT nombre (#PCDATA)>
    <!ELEMENT apellido (#PCDATA)>
    <!ELEMENT edad (#PCDATA)>
    <!ELEMENT departamento (#PCDATA)>
    <!ELEMENT cargo (#PCDATA)>

]>

